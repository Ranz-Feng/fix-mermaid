{
  "name": "fix-mermaid",
  "version": "0.1.0",
  "description": "Repair and convert Mermaid to Markmap Markdown locally, without model calls.",
  "type": "module",
  "main": "./src/fixMermaid.js",
  "module": "./src/fixMermaid.js",
  "exports": {
    ".": "./src/fixMermaid.js",
    "./render": "./src/mermaid-render.js"
  },
  "files": ["src", "README.md", "README_CN.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "test": "node test/node.test.mjs && node --test test/markmap.test.mjs",
    "test:markmap-browser": "node test/browser/markmap.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node test/browser/site.mjs",
    "demo": "python -m http.server 8765 --bind 127.0.0.1"
  },
  "keywords": ["mermaid", "llm", "ai", "repair", "fix", "syntax", "markdown", "chatbot", "diagram"],
  "license": "MIT",
  "peerDependencies": {
    "mermaid": ">=10"
  },
  "peerDependenciesMeta": {
    "mermaid": { "optional": true }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "playwright": "^1.64.1",
    "mermaid": "^11.12.0"
  }
}
